# Server Configuration
PORT=8004
HOST=0.0.0.0
FLASK_ENV=development

# Application Secrets
SECRET_KEY=featureapp-dev-secret-key-change-in-prod
JWT_SECRET_KEY=featureapp-jwt-token-secret-key-change-in-prod
JWT_ACCESS_TOKEN_EXPIRES_DAYS=30

# MongoDB Configuration
# In Docker Compose, service name is 'mongo'. For local execution without Docker, use localhost.
MONGO_URI=mongodb://mongo:27017/featureapp
MONGO_DB_NAME=featureapp

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# AI Generator Configuration (Antigravity SDK)
ANTIGRAVITY_API_KEY=your_antigravity_api_key_here
